# ── Firebase secrets ──────────────────────────────────────────────────────────
# The stub GoogleService-Info.plist IS committed (it contains no real secrets).
# REPLACE it with your real one from Firebase Console before running the app.
# If you have a real plist locally, name it GoogleService-Info.real.plist
# and it will stay ignored:
GoogleService-Info.real.plist

